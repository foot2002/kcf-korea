# 개인정보보호 문의 관리자 페이지(/admin) 비밀번호 (로컬 서버)
# 미설정 시 기본값: kcf2026
PRIVACY_ADMIN_KEY=kcf2026

# GitHub Pages 정적 배포 시 /admin 로그인 비밀번호 (빌드 시 주입, 미설정 시 kcf2026)
VITE_PRIVACY_ADMIN_KEY=kcf2026

# 협단체 협약 신청 Google Apps Script Web App URL
# 배포 후 발급된 URL (예: https://script.google.com/macros/s/.../exec)
VITE_ASSOCIATION_APPLICATION_API_URL=

# GAS 스크립트 ADMIN_TOKEN과 동일 (GitHub Pages 관리자 탭에서 목록 조회·수정 시 사용)
VITE_ASSOCIATION_ADMIN_TOKEN=
